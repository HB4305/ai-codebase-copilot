PORT=4000
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini # For OpenRouter, use format like "openai/gpt-4o-mini" or "google/gemini-2.5-flash"
# OPENAI_BASE_URL=https://openrouter.ai/api/v1 # Optional: automatically detected if API key starts with sk-or-v1-
GITHUB_TOKEN=your-github-personal-access-token-here (Optional: increases API limit from 60 to 5000 requests/hr)

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Rate Limit Configuration (Default: 15 minutes window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ANALYZE=5
RATE_LIMIT_MAX_CHAT=60

# ── Qdrant Cloud Configuration ──
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=codebase_chunks

# ── Embedding Configuration ──
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=

# ── Indexing Limits & Schema ──
INDEX_MAX_FILES=200
INDEX_MAX_FILE_BYTES=60000
INDEX_MAX_FILE_TOKENS=6000
INDEX_SCHEMA_VERSION=1
